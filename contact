<main id="main">

  <!-- CONTACT / BOOKING -->
  <section class="contact contact--page">
    <div class="section-inner contact__grid">
      <div class="contact__intro">
        <p class="eyebrow">Booking &amp; contact</p>
        <h2>Ready to start?</h2>
        <p>Send a message with a bit about your voice and what you're hoping to work on, and I'll get back to you to find a time.</p>
        <ul class="contact__details">
          <li><strong>Email</strong><br><a href="mailto:surleac.iuliana@gmail.com">surleac.iuliana@gmail.com</a></li>
          <li><strong>Location</strong><br>Copenhagen, Denmark — in-person sessions by appointment</li>
        </ul>

        <div class="social-links">
          <a href="https://www.instagram.com/voicewithiuliana/" class="social-links__item" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="17.3" cy="6.7" r="1.1" fill="currentColor"/></svg>
          </a>
          <a href="https://www.youtube.com/@isjudyhere" class="social-links__item" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="5.5" width="19" height="13" rx="4" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M10 9.2 L15.2 12 L10 14.8 Z" fill="currentColor"/></svg>
          </a>
          <a href="https://www.tiktok.com/@voicewithiuliana" class="social-links__item" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3v10.5a2.8 2.8 0 1 1-2.2-2.74" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M14 3c0 2.6 2 4.6 4.5 4.7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          </a>
        </div>
      </div>

      <form class="contact__form" id="bookingForm" method="POST" action="mailto:surleac.iuliana@gmail.com" enctype="text/plain">
        <!-- This form opens the visitor's email client with the fields pre-filled — no backend or cost required. -->
        <div class="form-row">
          <label for="name">Name</label>
          <input type="text" id="name" name="Name" required>
        </div>
        <div class="form-row">
          <label for="email">Email</label>
          <input type="email" id="email" name="Email" required>
        </div>
        <div class="form-row">
          <label for="lessonType">Interested in</label>
          <select id="lessonType" name="Interested in">
            <option>Vocal Coaching</option>
            <option>Vocal Exploration</option>
            <option>Not sure yet</option>
          </select>
        </div>
        <div class="form-row">
          <label for="format">Format</label>
          <select id="format" name="Format">
            <option>Online</option>
            <option>In person</option>
          </select>
        </div>
        <div class="form-row">
          <label for="message">Message</label>
          <textarea id="message" name="Message" rows="4" required></textarea>
        </div>
        <button type="submit" class="btn btn--primary">Send message</button>
      </form>
    </div>
  </section>

</main>
